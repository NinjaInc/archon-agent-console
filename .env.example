# =============================================================================
# ARCHON AGENT CONSOLE (Archon Tech - Josh Neufield)
# Copy to /etc/archon-agent-console/env (systemd) or .env (development).
# NEVER commit the real file. Secrets: BOOTSTRAP_TOKEN, CF_* values, GEMINI keys.
# =============================================================================

# --- Network: loopback by default. A single private LAN IPv4 of this machine is allowed only
# with ALLOW_LAN_BIND=true (e.g. when cloudflared runs on another host). 0.0.0.0, :: and public
# addresses always make the server exit. ---
HOST=127.0.0.1
# ALLOW_LAN_BIND=true
SERVER_PORT=3001

# --- Passkeys (WebAuthn). The browser must use exactly APP_ORIGIN (https, a real hostname). ---
# Test through the tunnel hostname; localhost only works for local development.
APP_ORIGIN=https://console.example.com
# Usually the hostname of APP_ORIGIN (or a parent domain of it).
RP_ID=console.example.com
RP_NAME=Archon Agent Console
# Idle timeout (minutes) and absolute session lifetime (hours).
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# Optional: use this as the first-run setup token instead of a random one printed on the console.
# Must be 24+ characters, is single-use and expires 15 minutes after each server start.
# BOOTSTRAP_TOKEN=

# --- Cloudflare Access (defence in depth; the app re-verifies the Access JWT itself) ---
# When true the server refuses every request/websocket without a valid Cf-Access-Jwt-Assertion,
# and refuses to start if the next two values are missing.
CF_ACCESS_REQUIRED=false
# Zero Trust > Settings > Custom Pages shows your team domain.
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# The Access application's "Application Audience (AUD) Tag".
# CF_ACCESS_AUD=

# --- Where the file explorer, terminals and new projects may live (comma separated) ---
# Everything is checked after symlink resolution. Default: ~/projects,~/src,~/drive (those that exist).
PROJECTS_ROOTS=/srv/archon/projects

# --- Antigravity (agy) ---
# Set the Gemini API key from the app (Settings API) instead of here; it is stored in an
# owner-only file and only injected into agy terminals. OAuth works via the terminal's login URL.

# =============================================================================
# UPSTREAM CLOUDCLI SETTINGS
# =============================================================================

# CloudCLI UI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'cloudcli status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   cloudcli start    - Start the server
#   cloudcli status   - Show configuration and data locations
#   cloudcli help     - Show help information
#   cloudcli version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
#Frontend port
VITE_PORT=5173

# (HOST is set in the Archon section above and must stay a loopback address.)

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db
#
# Claude Code context window size (maximum tokens per session). Fallback only:
# a Claude session uses the window the SDK reports for its model once a turn completes.
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000


